{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verba",
  "version": "0.1.0",
  "identifier": "app.verba.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../ui"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../ui"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Verba",
        "width": 1600,
        "height": 980,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Video",
    "resources": [
      "lib/*"
    ],
    "shortDescription": "Sottotitoli automatici in locale",
    "longDescription": "Trascrive un file audio o video con i tempi di ogni parola e ne esporta i sottotitoli: come file di testo, come video con i sottotitoli impressi, o come overlay su sfondo trasparente. Gira interamente sulla macchina di chi lo usa.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
